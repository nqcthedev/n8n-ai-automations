        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Convert simple test emails into the Gmail Trigger (Simplify OFF) shape.\nconst emails = ($input.first().json.body && $input.first().json.body.emails) || [];\nreturn emails.map((e, i) => ({\n  json: {\n    id: 'test-' + i + '-' + Date.now(),\n    threadId: 'test-thread-' + i,\n    isSample: true, // forces dry run in the worker\n    date: new Date().toISOString(),\n    subject: e.subject || '',\n    text: e.body || '',\n    from: { value: [{ address: e.from || '', name: e.from_name || '' }], text: e.from || '' },\n    headers: e.headers || {},\n  },\n}));\n"
      }
    },
    {
      "id": "6c9ce780-a5c4-418e-a792-f1d54f5fbef9",
      "name": "Run support worker",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        576,
        0
