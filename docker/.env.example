# Copy to .env and replace every CHANGE_ME value:   cp .env.example .env
# Generate secrets with:   openssl rand -hex 32
# Never commit .env.

# ---------------------------------------------------------------- versions
N8N_VERSION=2.48.6

# ---------------------------------------------------------------- public URL
# Domain that points to this server (A/AAAA record). Used for the editor,
# webhook URLs, Slack approval links and error-alert links.
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
# true behind HTTPS. Set to false only for plain-http testing on localhost.
N8N_SECURE_COOKIE=true
# Number of reverse proxies in front of n8n (1 = Caddy).
N8N_PROXY_HOPS=1
# Email for Let's Encrypt certificate notices (profile "https").
ACME_EMAIL=CHANGE_ME@example.com
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh

# ---------------------------------------------------------------- secrets
# 32+ random characters. BACK THIS UP - without it stored credentials are lost.
N8N_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password_1
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=CHANGE_ME_strong_password_2

# ---------------------------------------------------------------- scaling
# regular | queue   (queue also needs: docker compose --profile queue up -d)
EXECUTIONS_MODE=regular
# Keep execution history for 14 days / max 50k executions.
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000

# ---------------------------------------------------------------- workflows
# true = no Slack / Gmail / Google Sheets side effects (safe first run).
AUTOMATION_DRY_RUN=true

# LLM model ids for the "OpenAI-compatible LLM" credential's provider.
#   Gemini (base URL https://generativelanguage.googleapis.com/v1beta/openai/):
#     gemini-flash-lite-latest / gemini-flash-latest
#   OpenAI (base URL https://api.openai.com/v1):
#     gpt-4.1-mini / gpt-4.1
LLM_MODEL=gemini-flash-lite-latest
LLM_FALLBACK_MODEL=gemini-flash-latest

# Used in prompts and email signatures.
BUSINESS_NAME=Acme Digital
BUSINESS_PROFILE=Acme Digital is a 12-person studio that builds web apps, AI assistants and workflow automations for small and mid-sized businesses. Typical project size USD 3k-40k. We do not offer logo design or SEO link building.
EMAIL_SIGNATURE=The Acme Digital team
SUPPORT_SIGNATURE=The Acme Digital support team

# Lead qualifier
LEAD_HOT_SCORE_THRESHOLD=70
LEAD_DEDUPE_WINDOW_HOURS=72
# Never true in production if the form posts directly from browsers:
# it would show your internal lead score to the lead.
LEAD_RESPONSE_DETAILS=false

# Support triage: how long a Slack approval request waits before giving up.
SUPPORT_APPROVAL_TIMEOUT_HOURS=24

# Invoice validation tolerance for rounding (in invoice currency).
INVOICE_AMOUNT_TOLERANCE=0.02

# Slack channels (the Slack app must be invited to each channel).
SLACK_CHANNEL_SALES=#sales-leads
SLACK_CHANNEL_SUPPORT=#support-approvals
SLACK_CHANNEL_FINANCE=#finance-invoices
SLACK_CHANNEL_ALERTS=#n8n-alerts
ALERT_EMAIL_TO=ops@example.com

# One Google Sheet with tabs: Leads, Support log, Invoices, Invoice review
# (the ID is the long part of the sheet URL between /d/ and /edit).
GOOGLE_SHEET_ID=CHANGE_ME
