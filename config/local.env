# Local demo / test configuration for scripts/local-n8n.sh.
# Values already set in the environment win (VAR=${VAR:-default}).
# No secrets in this file. Put your API key in .env.local (git-ignored):
#   echo 'LLM_API_KEY=sk-...' > .env.local
#
# --- LLM (any OpenAI-compatible Chat Completions endpoint) ------------------
# Gemini:  https://generativelanguage.googleapis.com/v1beta/openai/
# OpenAI:  https://api.openai.com/v1   (then use e.g. LLM_MODEL=gpt-4.1-mini)
LLM_BASE_URL=${LLM_BASE_URL:-https://generativelanguage.googleapis.com/v1beta/openai/}
LLM_API_KEY=${LLM_API_KEY:-}
LLM_MODEL=${LLM_MODEL:-gemini-flash-lite-latest}
LLM_FALLBACK_MODEL=${LLM_FALLBACK_MODEL:-gemini-flash-latest}

# --- Workflow behaviour ------------------------------------------------------
# Dry run: no Slack / Gmail / Google Sheets calls. Everything else runs for real
# (validation, dedupe, LLM calls, routing, webhook responses).
AUTOMATION_DRY_RUN=${AUTOMATION_DRY_RUN:-true}
# Include the AI qualification in the lead webhook response (testing only).
LEAD_RESPONSE_DETAILS=${LEAD_RESPONSE_DETAILS:-true}
LEAD_HOT_SCORE_THRESHOLD=${LEAD_HOT_SCORE_THRESHOLD:-70}
LEAD_DEDUPE_WINDOW_HOURS=${LEAD_DEDUPE_WINDOW_HOURS:-72}
INVOICE_AMOUNT_TOLERANCE=${INVOICE_AMOUNT_TOLERANCE:-0.02}

# --- Local editor login (local only, change if you expose the port) ---------
LOCAL_OWNER_EMAIL=${LOCAL_OWNER_EMAIL:-admin@example.com}
LOCAL_OWNER_PASSWORD=${LOCAL_OWNER_PASSWORD:-LocalDemo-2026}
